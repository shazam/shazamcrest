source(verifyLib);

expectFilesUnder("src", new String[] {
        "it/java/billing/a7b8c9/0d1e2f-approved.json",
        "it/java/orders/c1a2b3/9f8e7d-approved.json",
        "it/java/orders/c1a2b3/d4e5f6-approved.json",
        "it/java/shipping/b3c4d5/e6f7a8-approved.json"});

