expectContentUnder("src/it/java", "orders/c1a2b3/d4e5f6-approved.json", "/*orders.OrderTest.c*/" + content);
expectContentUnder("src/it/java", "billing/a7b8c9/0d1e2f-approved.json", "/*billing.InvoiceTest.a*/" + content);
expectContentUnder("src/it/java", "shipping/b3c4d5/e6f7a8-approved.json", "/*shipping.ParcelTest.b*/" + content);
expectContentUnder("src/it/java", "orders/c1a2b3/9f8e7d-approved.json", "/*orders.OrderTest.unique*/\n{\n  \"total\": 7\n}");
