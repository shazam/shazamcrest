import java.io.File;
import java.nio.file.Files;
import java.util.ArrayList;
import java.util.Arrays;
import java.util.Collections;
import java.util.List;

void collectFiles(File dir, String prefix, List out) {
    File[] children = dir.listFiles();
    for (int i = 0; i < children.length; i++) {
        String name = prefix + children[i].getName();
        if (children[i].isDirectory()) {
            collectFiles(children[i], name + "/", out);
        } else {
            out.add(name);
        }
    }
}

void expectFiles(String[] expected) {
    expectFilesUnder("src/test/java", expected);
}

void expectFilesUnder(String root, String[] expected) {
    List files = new ArrayList();
    collectFiles(new File(basedir, root), "", files);
    Collections.sort(files);
    List expectedFiles = Arrays.asList(expected);
    if (!expectedFiles.equals(files)) {
        throw new IllegalStateException("files: expected " + expectedFiles + " but was " + files);
    }
}

void expectContent(String relative, String expected) {
    expectContentUnder("src/test/java", relative, expected);
}

void expectContentUnder(String root, String relative, String expected) {
    File file = new File(new File(basedir, root), relative);
    String actual = new String(Files.readAllBytes(file.toPath()), "UTF-8");
    if (!expected.equals(actual)) {
        throw new IllegalStateException(relative + "\nexpected:\n" + expected + "\nactual:\n" + actual);
    }
}

void expectLogLine(String expected) {
    String log = new String(Files.readAllBytes(new File(basedir, "build.log").toPath()), "UTF-8").replace("\r\n", "\n");
    if (log.indexOf("[INFO] " + expected + "\n") < 0) {
        throw new IllegalStateException("build.log has no line: [INFO] " + expected);
    }
}

void expectLogLacks(String unexpected) {
    String log = new String(Files.readAllBytes(new File(basedir, "build.log").toPath()), "UTF-8");
    if (log.indexOf(unexpected) >= 0) {
        throw new IllegalStateException("build.log contains: " + unexpected);
    }
}

void expectLogContains(String expected) {
    String log = new String(Files.readAllBytes(new File(basedir, "build.log").toPath()), "UTF-8");
    if (log.indexOf(expected) < 0) {
        throw new IllegalStateException("build.log does not contain: " + expected);
    }
}
