source(verifyLib);

expectFiles(new String[] {
        "billing/a7b8c9/0d1e2f-approved.json",
        "orders/c1a2b3/9f8e7d-approved.json",
        "orders/c1a2b3/d4e5f6-approved.json",
        "shipping/b3c4d5/e6f7a8-approved.json"});

String content = "\n{\n  \"total\": 42,\n  \"currency\": \"GBP\"\n}";
expectContent("orders/c1a2b3/d4e5f6-approved.json", "/*orders.OrderTest.c*/" + content);
expectContent("billing/a7b8c9/0d1e2f-approved.json", "/*billing.InvoiceTest.a*/" + content);
expectContent("shipping/b3c4d5/e6f7a8-approved.json", "/*shipping.ParcelTest.b*/" + content);
expectContent("orders/c1a2b3/9f8e7d-approved.json", "/*orders.OrderTest.unique*/\n{\n  \"total\": 7\n}");
expectLogLine("Dry run, no files changed. Deduplication complete: 1 canonical(s) created, 3 pointer(s) written, 0 orphaned canonical(s) removed.");
